{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rpa-link-v0.1.schema.json",
  "title": "RPA-Link v0.1 message envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "type",
    "source",
    "destination",
    "sequence",
    "timestamp_us",
    "ttl_ms",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "RPA-LINK"
    },
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "HELLO",
        "HEARTBEAT",
        "SET_MODE",
        "JOINT_POSITION_CMD",
        "ESTOP",
        "ESTOP_RESET_REQUEST",
        "JOINT_TELEMETRY",
        "SYSTEM_TELEMETRY",
        "FAULT",
        "ACK"
      ]
    },
    "source": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "destination": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "timestamp_us": {
      "type": "integer",
      "minimum": 0
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "payload": {
      "type": "object"
    }
  }
}
